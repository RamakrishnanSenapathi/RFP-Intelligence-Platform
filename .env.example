# ---- Required ----
GOOGLE_API_KEY=your-google-ai-studio-key

# ---- Models (change freely; any Gemini model your key can access) ----
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ---- Backends ----
EMBEDDER_BACKEND=gemini        # gemini | hash (offline, tests only)
RERANKER_BACKEND=llm           # llm | cross_encoder | none

# ---- Rate limiting (free tier is low; raise if you have a paid key) ----
LLM_RPM=12
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=4
# GEMINI_THINKING_BUDGET=0     # optional: 0 disables thinking on 2.5 models (faster/cheaper)

# ---- Chunking / retrieval ----
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_CHARS=150
RERANK_CANDIDATES=15
RRF_K=60

# ---- Agents ----
MAX_FIELD_RETRIES=2
RERANK_IN_EXTRACTION=true
LLM_QUERY_REWRITE=true

# ---- Paths (optional) ----
# DATA_DIR=./data
# OUTPUT_DIR=./output
